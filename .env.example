# ── AI 모델(하나 이상) ──────────────────────────
# 비교·예비: GPT-OSS 120B @ Groq  https://console.groq.com/keys
GROQ_API_KEY=
# 기본: Gemma 4 31B @ Google AI Studio  https://aistudio.google.com/api-keys
GOOGLE_API_KEY=
# GOOGLE_API_KEY 대신 GEMINI_API_KEY 또는 GOOGLE_GENERATIVE_AI_API_KEY도 인식
# 선택: 모델 이름만 교체(비워 두면 기본값)
GROQ_GPTOSS_MODEL=openai/gpt-oss-120b
GEMMA_MODEL=gemma-4-31b-it
# 기존 GROQ_MODEL·GOOGLE_MODEL도 별칭으로 지원(새 이름이 우선)
# 자동 연결 우선 모델 ID. 개별 작업에서 명시한 모델이 더 우선함.
DEFAULT_MODEL_ID=gemma4-31b@google
# Gemma 4: minimal(기본, 빠른 초안 작성) 또는 high(추론 사용)
# high는 공개 서버의 요청 시간 제한에 걸릴 수 있음
GOOGLE_THINKING_LEVEL=minimal
# 선택 예비
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
UPSTAGE_API_KEY=
CLOVA_API_KEY=
# 선택: OpenAI API (별도 제공자 계정)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 기관 AI 서버(OpenAI 호환: EXAONE·HyperCLOVA X SEED 등 vLLM)
CUSTOM_LLM_BASEURL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_KEY=
# 브라우저에서 입력할 수 있는 추가 기관 주소(쉼표 구분). 기본 주소는 위에 등록.
CUSTOM_LLM_ALLOWED_BASEURLS=
# 기존 ID 덮어쓰기 또는 새 모델 추가(JSON 배열, 선택)
MODELS_JSON=
# 서버 인스턴스별 기본 연결 하루 호출 근사 한도(공급자 결제 한도를 대체하지 않음)
TRIAL_DAILY_LIMIT=800

# ── 법제처 국가법령정보 공동활용 API ───────────
# https://open.law.go.kr 에서 신청·승인받은 API 인증값(OC)
LAW_OC=
# 신청 시 등록한 도메인(직접 호출 Referer)
LAW_REFERER=
# 승인된 환경에서 운영하는 중계 서버(relay/render-law-relay.js)
LAW_RELAY_URL=
LAW_RELAY_SECRET=
# 입안 참고자료 검색은 추가 키·벡터DB 없이 배포된 색인을 사용합니다.
